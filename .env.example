# Copy this file to .env and fill in your Supabase project credentials.
# Find these under Project Settings > API in your Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --------------------------------------------------------------------------
# Everything below is NOT read by the frontend. These are Supabase Edge
# Function secrets — set them with the Supabase CLI, e.g.:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# They are listed here purely for reference.
# --------------------------------------------------------------------------

# supabase/functions/create-checkout-session, billing-portal, stripe-webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=          # Stripe Price id for the 9,90 €/mois plan
# STRIPE_PRICE_ANNUAL=       # Stripe Price id for the 89 €/an plan
# APP_URL=https://your-app-domain.example              # used to build Stripe redirect URLs

# supabase/functions/send-whatsapp-campaign (Meta WhatsApp Cloud API)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Auto-provided by Supabase in every Edge Function — no need to set these:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
